# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_MAPS_API_KEY: Google Maps SDK & Places API key for real-time delivery address geocoding and location pin
GOOGLE_MAPS_API_KEY=DEFAULT_GOOGLE_MAPS_API_KEY

# RAZORPAY_KEY_ID: Standard Indian multi-option payment gateway (UPI, GPay, PhonePe, Paytm, RuPay/Cards, NetBanking)
RAZORPAY_KEY_ID=DEFAULT_RAZORPAY_KEY_ID
